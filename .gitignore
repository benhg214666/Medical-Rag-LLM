# 虛擬環境
.venv/
venv/
env/

# Python 快取與編譯檔
__pycache__/
*.py[cod]
*$py.class

# Python build / 打包產物
build/
dist/
*.egg-info/
.eggs/

# 環境變數（不可提交真正的機密設定）
.env

# 測試與型別檢查快取
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 編輯器與 IDE
.vscode/
.idea/

# 作業系統暫存檔
.DS_Store
Thumbs.db
desktop.ini

# 本地資料與模型（保留資料夾本身）
vector_db/*
!vector_db/.gitkeep
models/*
!models/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
