# 虛擬環境
.venv/
venv/
env/

# Python 快取與編譯檔
__pycache__/
*.py[cod]
*$py.class

# Python build / 打包產物
build/
dist/
*.egg-info/
.eggs/

# 環境變數（不可提交真正的機密設定）
.env

# 測試與型別檢查快取
.pytest_cache/
.pytest-*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 編輯器與 IDE
.vscode/
.idea/

# 作業系統暫存檔
.DS_Store
Thumbs.db
desktop.ini

# 本地資料與模型（保留資料夾本身）
#
# 醫療資料安全：data/raw 與 data/processed 可能含有病歷或其他敏感內容，
# 絕對不可進入版本控制。一旦推上遠端（尤其是公開 repo），
# 即使之後刪除檔案，commit 歷史中仍然找得到。
vector_db/*
!vector_db/.gitkeep
models/*
!models/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/evaluation/*
!data/evaluation/.gitkeep
!data/evaluation/example_cases.jsonl

# Phase 8 runtime evaluation artifacts (versioned data lives in data/demo/)
reports/demo/*
!reports/demo/.gitkeep
