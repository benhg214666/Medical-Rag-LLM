# 應用程式基本資訊（Phase 1）
APP_NAME=Medical Local RAG
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# 資料目錄（Phase 2）
# 使用相對於專案根目錄的路徑，方便在不同機器（含 Linux Lab 主機）之間搬移。
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# 上傳限制（Phase 2）
MAX_UPLOAD_SIZE_MB=20

# 切塊參數（Phase 2）
# 注意：單位是「字元數」，不是 token。
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=50

# Embedding + Vector Store（Phase 3）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
VECTOR_STORE_PROVIDER=chroma
VECTOR_DB_DIR=vector_db
CHROMA_COLLECTION_NAME=medical_documents

# 檢索（Phase 4）
# RETRIEVAL_TOP_K 是查詢未指定 top_k 時的預設回傳筆數。
# RETRIEVAL_MAX_TOP_K 是允許的上限，防止呼叫端要求過大的結果集。
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=50
